{
  "name": "MorphAgent",
  "version": "5.0.0",
  "description": "Modern User Agent & Anti-Fingerprinting Suite",
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "homepage_url": "https://github.com/karthik558/MorphAgent",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "tabs",
    "scripting",
    "contextMenus",
    "alarms",
    "proxy",
    "privacy"
  ],
  "commands": {
    "apply-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Alt+Shift+M"
      },
      "description": "Apply the MorphAgent profile to the current site"
    },
    "pause-shield-site": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Pause or resume the shield on this site"
    },
    "open-profile-lab": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Alt+Shift+L"
      },
      "description": "Open the MorphAgent profile lab"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "morph-ads",
        "enabled": true,
        "path": "rules/ads.json"
      },
      {
        "id": "morph-trackers",
        "enabled": true,
        "path": "rules/trackers.json"
      },
      {
        "id": "morph-miners",
        "enabled": true,
        "path": "rules/miners.json"
      }
    ]
  },
  "background": {
    "scripts": [
      "js/background.js"
    ],
    "type": "module"
  },
  "options_ui": {
    "page": "advanced-settings.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MorphAgent 5.0.0",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/adblock-rules.js",
        "js/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "js/inject.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "morph-agent@karthiklal.in",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}